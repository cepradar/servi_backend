# ============================================================
# inventory-backend — Variables de entorno: PRODUCTION
# Reemplaza estos valores en el servidor o pipeline.
# Actívalo con: SPRING_PROFILES_ACTIVE=production
# ============================================================
SPRING_PROFILES_ACTIVE=production

DB_URL=jdbc:postgresql://db-host:5432/SERVI
DB_USER=change_me
DB_PASSWORD=change_me

JWT_SECRET=replace_with_a_real_64_char_secret_minimum________________________
JWT_EXPIRATION_MS=3600000

APP_CORS_ORIGINS=https://app.mi-empresa.com

SERVER_PORT=8080
DDL_AUTO=validate
FLYWAY_ENABLED=true
JPA_SHOW_SQL=false
REPORTS_STORAGE_PATH=./reports-storage
