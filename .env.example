# ============================================================
# inventory-backend — Variables de entorno (PLANTILLA)
#
# ESTRATEGIA DE ENTORNOS:
#   .env.example       → documentación / plantilla
#   .env.development   → valores base para desarrollo
#   .env.production    → placeholders de producción
#   .env.local         → overrides personales (git ignored)
#
# PERFIL:
#   SPRING_PROFILES_ACTIVE=local|development|production
# ============================================================

SPRING_PROFILES_ACTIVE=local

# ============================================================
# BASE DE DATOS
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/SERVI
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================
# JWT
# Debe tener al menos 64 caracteres ASCII para HS512.
# ============================================================
JWT_SECRET=0123456789012345678901234567890123456789012345678901234567890123
JWT_EXPIRATION_MS=36000000

# ============================================================
# CORS
# ============================================================
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# SERVIDOR / JPA / FLYWAY
# ============================================================
SERVER_PORT=8080
DDL_AUTO=update
FLYWAY_ENABLED=false
JPA_SHOW_SQL=false

# ============================================================
# REPORTES
# ============================================================
REPORTS_STORAGE_PATH=./reports-storage
